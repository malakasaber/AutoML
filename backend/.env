# FastAPI Configuration
FASTAPI_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# File Upload
MAX_UPLOAD_SIZE_MB=50
PREVIEW_ROWS=5

# Machine Learning
TEST_SIZE=0.2
RANDOM_STATE=42
